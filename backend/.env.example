# Copy this file to backend/.env to change settings.
# Without DATABASE_URL, the backend stores data in a local SQLite file (backend/trac.db).

# PostgreSQL example (replace USER, and PASSWORD if your database needs one):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/trac

# Where the AI service runs (default: http://127.0.0.1:8001).
# AI_SERVICE_URL=http://127.0.0.1:8001

# --- Disaster areas ---
# How far back reports count towards an area, and how often areas are worked out again.
# ZONE_WINDOW_HOURS=12
# ZONE_REFRESH_SECONDS=60

# Live earthquake feed. Set DISASTER_FEED=off to ignore it. No API key needed.
# DISASTER_FEED=on
# DISASTER_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.geojson
# DISASTER_FEED_SECONDS=600

# --- Safe routes ---
# The routing server. The default is the public OSRM demo, which is rate limited:
# point this at your own OSRM for anything beyond a demo.
# ROUTING_URL=https://router.project-osrm.org

# Turning typed place names into coordinates. GEOCODER=off looks only among the places
# TRAC already knows. Nominatim asks callers to identify themselves; say who you are here.
# GEOCODER=on
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GEOCODER_USER_AGENT=TRAC-TravelTechHackathon (travel disaster coordination)
