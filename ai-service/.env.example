# Copy this file to ai-service/.env to use a language model for reading reports.
# Without a key, the service uses its built-in keyword rules (fine for demos).

# Which provider to use: openai, groq or gemini.
AI_PROVIDER=openai

# The key for that provider (only the one you use is needed):
OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Optional: pick a different model than the default for the provider.
# OPENAI_MODEL=gpt-4o-mini
